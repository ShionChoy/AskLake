# ── LLM provider (swappable via the LLMProvider port). DeepSeek is the documented default.
DEEPSEEK_API_KEY=
# ASKLAKE_DEEPSEEK_MODEL=deepseek-v4-flash

# To use Anthropic/Claude instead, leave DEEPSEEK_API_KEY empty and set:
# ANTHROPIC_API_KEY=
# ASKLAKE_LLM_PROVIDER=anthropic
# ASKLAKE_LLM_MODEL=claude-sonnet-5

# ── Data (the built IMDb parquet working set; see `make build-imdb`)
ASKLAKE_PARQUET_DIR=data/imdb/parquet

# ── Observability (enables the /metrics endpoint)
ASKLAKE_OBSERVABILITY_BACKEND=prometheus

# ── Access control
# Local or identity-aware-gateway deployment: digest-only static credentials with lifecycle fields.
ASKLAKE_AUTH_MODE=static
ASKLAKE_AUTH_CONFIG=auth.yaml

# Direct multi-tenant deployment: validate asymmetric OIDC access tokens against a pinned issuer,
# audience and JWKS. The external claim must resolve to exactly one internal role. Uncomment all
# settings below and set ASKLAKE_AUTH_MODE=oidc; HTTPS is mandatory and anonymous is off by default.
# ASKLAKE_OIDC_ISSUER=https://identity.example.com/
# ASKLAKE_OIDC_AUDIENCE=asklake-api
# ASKLAKE_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# ASKLAKE_OIDC_ROLE_CLAIM=groups
# ASKLAKE_OIDC_USER_CLAIM=preferred_username
# ASKLAKE_OIDC_ROLE_MAPPING={"asklake-public":"public","asklake-analyst":"analyst","asklake-steward":"steward"}
# ASKLAKE_OIDC_ALGORITHMS=RS256
# ASKLAKE_OIDC_ALLOW_ANONYMOUS=false

# Persistent structured audit events. Query content is hashed, not logged, by default.
ASKLAKE_AUDIT_PATH=data/audit/events.jsonl

# ── Service
ASKLAKE_API_HOST=0.0.0.0
ASKLAKE_API_PORT=8000
# Base URL the Streamlit UI uses to reach the API
ASKLAKE_API_URL=http://localhost:8000

# Optional externally managed knowledge-graph backend: memory (default, in-process) or neo4j
ASKLAKE_GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
